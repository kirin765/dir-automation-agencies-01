# Build-time vars consumed by Astro (import.meta.env). Copy to .env for local builds.

# Cloudflare Turnstile Site Key (public). Required at BUILD time so the widget
# renders in the static output. In CI this comes from the GitHub Actions
# repo Variable PUBLIC_TURNSTILE_SITE_KEY.
PUBLIC_TURNSTILE_SITE_KEY=

# Optional: override the canonical site URL / base path used by the build.
# PUBLIC_SITE_URL=https://automationagencydirectory.com
# PUBLIC_BASE_PATH=/
